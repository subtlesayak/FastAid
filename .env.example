# FastAid environment variables
#
# Keep real values in .env / .env.local and never commit them.

# Server-only key for Places API, Routes API, Geocoding, and other web-service calls.
GOOGLE_MAPS_SERVER_KEY=

# Client keys must be restricted in Google Cloud Console.
# Android: restrict by package name + SHA-1 certificate.
# iOS: restrict by bundle identifier.
# Web: restrict by allowed HTTP referrers/domains.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_WEB_KEY=

# Pilot backend persistence and authentication.
# Pilot mode requires an HTTPS public URL, Maps key, active admin, and writable storage.
FASTAID_DEPLOYMENT_MODE=local
FASTAID_PUBLIC_BASE_URL=
# Keep the admin password in the local/deployment secret store, never in source.
FASTAID_DATA_FILE=
FASTAID_ADMIN_EMAIL=
FASTAID_ADMIN_PASSWORD=
FASTAID_ADMIN_NAME=FastAid Pilot Admin
FASTAID_SESSION_TTL_MINUTES=60

# Single-process abuse controls. Trust proxy headers only behind a configured proxy.
FASTAID_TRUST_PROXY=0
FASTAID_AUTH_RATE_LIMIT=20
FASTAID_AUTH_RATE_WINDOW_MS=300000
FASTAID_INCIDENT_RATE_LIMIT=10
FASTAID_INCIDENT_RATE_WINDOW_MS=60000

# Responder assignment and notification delivery.
FASTAID_ALERT_TIMEOUT_SECONDS=45
FASTAID_ALERT_SWEEP_INTERVAL_MS=1000
FASTAID_NOTIFICATION_PROVIDER=local
FASTAID_NOTIFICATION_MAX_ATTEMPTS=3

# Provider secrets remain optional until a remote adapter is enabled.
FCM_SERVER_KEY=
SMS_PROVIDER_API_KEY=
